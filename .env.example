# ══════════════════════════════════════════════════════════════
# MONEYWATCH PRO — ENVIRONMENT VARIABLES SPECIFICATION
# ══════════════════════════════════════════════════════════════

# AI Engine Configuration (Server-Side Only)
# Hierarki Provider AI:
# 1. Google Gemini (Utama / Primary)
# 2. Anthropic Claude (Backup 1)
# 3. OpenRouter (Backup 2)
# 4. Deterministic Engine (Safety Net lokal jika seluruh API eksternal padam)

# Google Gemini API key — Provider Utama untuk StockChat AI, Bandarmology, dan Market Radar.
# Dapatkan gratis di https://aistudio.google.com/
GEMINI_API_KEY=
# Opsional model Gemini (default: gemini-2.5-flash):
# GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude API key — Backup 1 (jika Gemini kuota habis atau rate-limit)
ANTHROPIC_API_KEY=
# Opsional model Claude (default: claude-3-5-sonnet-20241022):
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenRouter API key — Backup 2 (opsional, redundansi lintas-vendor)
OPENROUTER_API_KEY=
# Opsional model OpenRouter (default: anthropic/claude-3.5-sonnet):
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Invezgo API key (https://docs.invezgo.com/api) — untuk data Broker Summary
# per-saham (Bandarmology) yang REAL, menggantikan simulasi. Tanpa key ini,
# generateBrokerSummary() otomatis fallback ke simulasi berlabel jujur
# "isSimulated: true". Butuh paket berlangganan aktif (minimal Advance).
INVEZGO_API_KEY=

# Upstash Redis (REST API) — WAJIB diset sebelum INVEZGO_API_KEY dipakai di
# production. Menyimpan quota counter bulanan (30.000 req/bulan pada paket
# Advance) & cache respons Invezgo di storage yang persisten lintas
# serverless invocation (Vercel) — bukan in-memory. Tanpa ini, quota
# enforcement TIDAK bisa diandalkan (lihat lib/invezgo-client.js).
# Buat database gratis di https://console.upstash.com lalu salin REST URL/token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opsional — override default quota/concurrency/retry Invezgo client.
# INVEZGO_MONTHLY_QUOTA=30000
# INVEZGO_MAX_CONCURRENCY=5
# INVEZGO_MAX_RETRIES=3

# WAJIB untuk endpoint cron /api/cron/warm-radar-fundamentals (Opportunity
# Radar). String rahasia bebas (mis. hasil `openssl rand -hex 32`) — dicocokkan
# terhadap header "Authorization: Bearer <CRON_SECRET>" yang otomatis dikirim
# Vercel Cron. Tanpa ini, endpoint selalu menolak (403), fail-closed by design.
CRON_SECRET=

# Supabase (per-user data + auth) — Server & Client Safe (anon/publishable
# key, restricted by Supabase Row Level Security, not a secret). Optional:
# lib/auth-verify.js and public/js/00-config.js already hardcode the
# current project's values as a fallback; only set these if the project is
# ever rotated to a different Supabase project.
# SUPABASE_URL=https://kpvteaqnjwkxkhenfqyu.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_IpA86ua5CkZ1UettBXR-tw_LUQFTyu0

# MW-P0-001 Stage 2 kill switch — OFF (unset/false) by default. Turns the
# /api/user-data/* identity check from Stage 1 telemetry-only into an
# actual 401 (missing/invalid session token) / 403 (token belongs to a
# different email than claimed). Only set to "true" after reviewing Stage
# 1's [AUTH TELEMETRY][MW-P0-001] logs in production and confirming no
# unexpected mismatches for real (non-demo) users — see lib/auth-*.js.
# AUTH_ENFORCE_STAGE2=true

# Data Quality Gate Stage 2 kill switch — OFF (unset/false) by default.
# When enabled: Exit Hypothesis withholds its technical/confluence/regime-
# based exit triggers (a direct SL/TP-breach check still always fires,
# since it doesn't depend on the gated history) whenever the underlying
# data fails the REAL/STALE/UNAVAILABLE/SIMULATION/INVALID gate; and the
# Scanner (computeStockSignal) forces a non-REAL ticker to "NO DATA"
# instead of a BUY/STRONG BUY signal. Only set to "true" after observing
# how often non-REAL status actually occurs in production — see
# lib/idx-data-engine.js's assessDataQuality()/DATA_QUALITY_ENFORCE_STAGE2.
# DATA_QUALITY_ENFORCE_STAGE2=true

# Production Server Configuration
PORT=3000
NODE_ENV=production
