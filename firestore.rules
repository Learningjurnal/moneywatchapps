rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User root document and any subcollections
    match /users/{userId} {
      allow read, write: if true;
      
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // KSEI 5%+ Shareholders & Free Float collections
    match /ksei_stocks/{ticker} {
      allow read, write: if true;
    }

    match /ksei_snapshots/{snapshotId} {
      allow read, write: if true;
    }

    match /ksei_metadata/{docId} {
      allow read, write: if true;
    }
  }
}
