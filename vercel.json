{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "{data/**,public/js/01-data.js,lib/**,server.js}",
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/idx/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=60, stale-while-revalidate=120" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|js/|data/|css/|public/|favicon.ico|manifest.json).*)",
      "destination": "/index.html"
    }
  ]
}
